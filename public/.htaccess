# ------------------------------------------------------------------------------
# Hostinger Apache / LiteSpeed Web Server Configuration for WISHMINT Static SPA
# ------------------------------------------------------------------------------

# Ensure correct MIME Types for modern JavaScript modules and styles
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType application/json .json
  AddCharset UTF-8 .html .js .mjs .css .json
</IfModule>

# Disable Directory Browsing
Options -Indexes

# Single Page Application (SPA) Client-Side Routing
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing physical files or directories directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other requests to index.html
  RewriteRule ^ index.html [L]
</IfModule>
